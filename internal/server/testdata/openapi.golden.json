          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A body larger than 262144 bytes."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree could not queue the message."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Queue a message for machine notify"
      }
    },
    "/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The OpenAPI document of the loaded config."
          }
        },
        "security": [],
        "summary": "This document"
      }
    },
    "/runs/{id}": {
      "get": {
        "description": "Runs `decree status <id> --format json`. Authenticated with the default bearer secret.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "pattern": "^(?:[A-Za-z0-9._-]{1,128})$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "description": "decree's document of the run, unchanged."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The id is outside its pattern."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree knows no such run."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree could not read the run."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "A run's status"
      }
    },
    "/runs/{wait_id}/replies/{event}": {
      "post": {
        "description": "Runs `decree event <wait_id> <event> [-m=<note>] --format json`. Authenticated with the default bearer secret.",
        "parameters": [
          {
            "in": "path",
            "name": "wait_id",
            "required": true,
            "schema": {
              "pattern": "^(?:[A-Za-z0-9._-]{1,128})$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "event",
            "required": true,
            "schema": {
              "pattern": "^(?:[A-Za-z0-9._-]{1,128})$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "The optional note, passed unchanged, of at most 262144 bytes.",
          "required": false
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            },
            "description": "The reply is queued."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, or a note holding a NUL byte."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The run is not waiting, or does not accept the event."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A note larger than 262144 bytes."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree could not queue the reply."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Reply to a run waiting for a person"
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "config": {
            "properties": {
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "loaded_at": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "loaded_at",
              "error"
            ],
            "type": "object"
          },
          "daemon": {
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "restarts": {
                "type": "integer"
              },
              "running": {
                "type": "boolean"
              },
              "since": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "enabled",
              "running",
              "pid",
              "restarts",
              "since"
            ],
            "type": "object"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "daemon",
          "config"
        ],
        "type": "object"
      },
      "Message": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The message id, also its run id once decree claims it.",
            "type": "string"
          },
          "machine": {
            "description": "The machine the message names.",
            "type": "string"
          },
          "path": {
            "description": "The queued file, relative to the project: .decree/inbox/<id>.md.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "machine"
        ],
        "type": "object"
      },
      "Reply": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The reply's message id.",
            "type": "string"
          },
          "path": {
            "description": "The queued file, relative to the project: .decree/inbox/<id>.md.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path"
        ],
        "type": "object"
      },
      "Run": {
        "description": "`decree status <id> --format json`, described by decree's .decree/schema/v1/cli/status.schema.json.",
        "properties": {
          "events": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "machine": {
            "type": "string"
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "active",
              "waiting",
              "pending",
              "interrupted",
              "finished"
            ]
          }
        },
        "required": [
          "id",
          "machine",
          "status",
          "state",
          "events"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
