{
  "openapi": "3.1.0",
  "info": {
    "description": "The HTTP front door of a decree project: each endpoint queues a decree message, replies to a run waiting in a reply state, or serves files from one machine's state/ folder, read-only.",
    "title": "decree-go-rest",
    "version": "1"
  },
  "paths": {
    "/approve/{wait_id}": {
      "post": {
        "description": "Runs `decree reply {{wait_id}} approve [-m=<note>] --format json`, with the body as the note. Authenticated with its own bearer secret.",
        "parameters": [
          {
            "in": "path",
            "name": "wait_id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "pattern": "^(?:[A-Za-z0-9._-]{1,128})$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "The optional note, passed unchanged, of at most 262144 bytes.",
          "required": false
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            },
            "description": "The reply is queued."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, a note that breaks the endpoint's body rule, or a note holding a NUL byte."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The run is not waiting, or does not accept the event."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A note larger than 262144 bytes."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree could not queue the reply."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Reply approve to a run waiting in a reply state"
      }
    },
    "/comfy/{type}/{name}": {
      "post": {
        "description": "Runs `decree emit --machine comfy_image`, with the body on stdin. Authenticated with its own bearer secret.",
        "parameters": [
          {
            "in": "path",
            "name": "type",
            "required": true,
            "schema": {
              "maxLength": 200,
              "pattern": "^(?:[a-z0-9-]+)$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "maxLength": 200,
              "pattern": "^(?:[A-Za-z0-9_.-]+)$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "The message body, opaque text of at most 262144 bytes; it must not be blank.",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "The message is queued."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, a body that breaks the endpoint's body rule, or a message decree rejected."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A body larger than 262144 bytes."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree could not queue the message."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Queue a message for machine comfy_image"
      }
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The daemon runs, or is disabled, and the config loaded."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The daemon is enabled but not running, or the last config reload failed."
          }
        },
        "security": [],
        "summary": "The daemon's and the config's health"
      }
    },
    "/leases/by-id/{id}": {
      "get": {
        "description": "Serves .decree/machines/gpu_lease/state/status/leases/{{id}}.json, read-only: a file as it is, a directory as a JSON listing. A file's Content-Type follows its extension: .json is application/json; .md text/markdown; .txt, .log, .yml and .yaml text/plain; any other application/octet-stream. Authenticated with its own bearer secret.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "pattern": "^(?:[0-9TZ.-]+-[a-f0-9]{6})$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Listing"
                    },
                    {}
                  ]
                }
              },
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "text/markdown": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "text/plain": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The file, or the directory's listing. A file's Content-Type follows its extension: .json is application/json; .md text/markdown; .txt, .log, .yml and .yaml text/plain; any other application/octet-stream.",
            "headers": {
              "Cache-Control": {
                "description": "no-cache: revalidate with If-None-Match each time.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "A strong tag: of a file, the SHA-256 of its content; of a listing, of its bytes.",
                "schema": {
                  "type": "string"
                }
              },
              "Last-Modified": {
                "description": "A file's modification time.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "206": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The range of the file that Range asked for."
          },
          "304": {
            "description": "Not modified: If-None-Match names the current ETag, or If-Modified-Since is not older than the file.",
            "headers": {
              "ETag": {
                "description": "A strong tag: of a file, the SHA-256 of its content; of a listing, of its bytes.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, or a path segment that is not [A-Za-z0-9._-]+ or starts with a dot."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Nothing there: missing, a name starting with a dot, outside the machine's state/ folder, or neither a regular file nor a directory."
          },
          "416": {
            "description": "A Range outside the file."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The state folder could not be read."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Read .decree/machines/gpu_lease/state/status/leases/{{id}}.json of machine gpu_lease"
      },
      "head": {
        "description": "Serves .decree/machines/gpu_lease/state/status/leases/{{id}}.json, read-only: a file as it is, a directory as a JSON listing. A file's Content-Type follows its extension: .json is application/json; .md text/markdown; .txt, .log, .yml and .yaml text/plain; any other application/octet-stream. Authenticated with its own bearer secret.",
        "parameters": [
