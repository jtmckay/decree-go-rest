    "/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The OpenAPI document of the loaded config."
          }
        },
        "security": [],
        "summary": "This document"
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "config": {
            "properties": {
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "loaded_at": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "loaded_at",
              "error"
            ],
            "type": "object"
          },
          "daemon": {
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "restarts": {
                "type": "integer"
              },
              "running": {
                "type": "boolean"
              },
              "since": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "enabled",
              "running",
              "pid",
              "restarts",
              "since"
            ],
            "type": "object"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "daemon",
          "config"
        ],
        "type": "object"
      },
      "Listing": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The entries, sorted by name, at most 1000. Names starting with a dot are never listed.",
            "items": {
              "$ref": "#/components/schemas/ListingEntry"
            },
            "type": "array"
          },
          "path": {
            "description": "The URL path of the directory.",
            "type": "string"
          },
          "truncated": {
            "description": "Present, and true, when the directory holds more than 1000 entries.",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "items"
        ],
        "type": "object"
      },
      "ListingEntry": {
        "additionalProperties": false,
        "properties": {
          "href": {
            "description": "The URL path to request the entry; a directory's ends in /. Absent from an endpoint with path parameters, which serves nothing below its path.",
            "type": "string"
          },
          "modified": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "description": "A file's size in bytes.",
            "type": "integer"
          },
          "type": {
            "enum": [
              "file",
              "directory"
            ]
          }
        },
        "required": [
          "name",
          "type",
          "modified"
        ],
        "type": "object"
      },
      "Message": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The message id, also its run id once decree claims it.",
            "type": "string"
          },
          "machine": {
            "description": "The machine the message names.",
            "type": "string"
          },
          "path": {
            "description": "The queued file, relative to the project: .decree/inbox/<id>.md.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "machine"
        ],
        "type": "object"
      },
      "Reply": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "description": "The event sent.",
            "type": "string"
          },
          "id": {
            "description": "The reply's message id.",
            "type": "string"
          },
          "path": {
            "description": "The queued file, relative to the project: .decree/inbox/<id>.md.",
            "type": "string"
          },
          "to": {
            "description": "The wait id of the run replied to.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "to",
          "event"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
