                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, or a path segment that is not [A-Za-z0-9._-]+ or starts with a dot."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Nothing there: missing, a name starting with a dot, outside the machine's state/ folder, or neither a regular file nor a directory."
          },
          "416": {
            "description": "A Range outside the file."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The state folder could not be read."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Read .decree/machines/gpu_lease/state/status/leases/{{id}}.json of machine gpu_lease, headers only"
      }
    },
