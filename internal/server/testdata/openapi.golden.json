{
  "openapi": "3.1.0",
  "info": {
    "description": "The HTTP front door of a decree project: each endpoint queues a decree message.",
    "title": "decree-api",
    "version": "1"
  },
  "paths": {
    "/comfy/{type}/{name}": {
      "post": {
        "description": "Runs `decree emit --machine comfy_image`, with the body on stdin. Authenticated with its own bearer secret.",
        "parameters": [
          {
            "in": "path",
            "name": "type",
            "required": true,
            "schema": {
              "maxLength": 200,
              "pattern": "^(?:[a-z0-9-]+)$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "maxLength": 200,
              "pattern": "^(?:[A-Za-z0-9_.-]+)$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "The message body, opaque text of at most 262144 bytes; it must not be blank.",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "The message is queued."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, a body that breaks the endpoint's body rule, or a message decree rejected."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A body larger than 262144 bytes."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree could not queue the message."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Queue a message for machine comfy_image"
      }
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The daemon runs, or is disabled, and the config loaded."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The daemon is enabled but not running, or the last config reload failed."
          }
        },
        "security": [],
        "summary": "The daemon's and the config's health"
      }
    },
    "/notify": {
      "post": {
        "description": "Runs `decree emit --machine notify`, with the body on stdin. Authenticated with the default bearer secret.",
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "The message body, opaque text of at most 262144 bytes; it must not be blank.",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "The message is queued."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, a body that breaks the endpoint's body rule, or a message decree rejected."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A missing or wrong bearer secret."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A body larger than 262144 bytes."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate budget is exhausted.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget's window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "decree could not queue the message."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Queue a message for machine notify"
      }
    },
    "/notify/{title}": {
      "post": {
        "description": "Runs `decree emit --machine notify`, with the body on stdin. Authenticated with the default bearer secret.",
        "parameters": [
          {
            "in": "path",
            "name": "title",
            "required": true,
            "schema": {
              "maxLength": 200,
              "pattern": "^(?:[A-Za-z0-9 _.-]{1,80})$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "The message body, opaque text of at most 262144 bytes; it must not be blank.",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "The message is queued."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A parameter outside its pattern, a body that breaks the endpoint's body rule, or a message decree rejected."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
